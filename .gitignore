# Core — single-template .gitignore
# Default policy: ship blank scaffolds (memory/, sessions/, tasks/, .claude/state/)
# in the template; track user data in forks; ignore secrets + noisy/runtime files.

# macOS
.DS_Store

# Office temp/lock files
~$*

# Editor / IDE
.obsidian/workspace.json
CLAUDE.local.md

# Secrets / credentials
*.key
*.env
.env.*
*.credentials.json
*.token.json
secrets/

# Claude Code per-machine permissions
.claude/settings.local.json

# Per-instance MCP wiring (org_id, peer server paths) — never the template's job to ship.
# Found populated with a real instance's config (org_id=2, a live peer-life entry) in the
# publish candidate; .mcp.json.template is the only .mcp.json* file the baseline should carry.
.mcp.json

# Runtime state files (hooks write at runtime — placeholder .gitkeep tracked)
.claude/state/*
!.claude/state/.gitkeep

# Claude Code auto-memory feedback files (these live under ~/.claude, not here,
# but block accidental check-in if they end up in memory/)
memory/feedback_*.md

# Generated brain artifacts (regenerated by pipeline)
graphify-out/
scheduling/graphify-brain/checkpoints/
scheduling/graphify-brain/graphify-out/
scheduling/graphify-brain/chunk-plan.txt
scheduling/graphify-brain/phase-11-tracker.md

# Brain vault (if user opts to keep a local copy under .brain/)
.brain/

__pycache__/
*.pyc
.claude/settings.json.bak
bin/.gate-trusted-sha

# per-seat test-runtime ratchet files written by run-all.sh; state, not source
**/.runtime-baseline
